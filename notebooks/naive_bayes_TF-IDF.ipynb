    "# --- STEP 3: Train the 4 Binary Models & Plot ---\n",
    "print(\"\\n🚀 Starting Naive Bayes Training...\")\n",
    "\n",
    "dimensions = [('I', 'E'), ('N', 'S'), ('T', 'F'), ('J', 'P')]\n",
