    "print(\"\\n\" + \"=\"*40)\n",
    "print(\"PART B: One Multi-Class Model (UNBALANCED)\")\n",
    "print(\"=\"*40)\n",
    "\n",
    "# Train on full 16 types directly\n",
    "clf_multi = MultinomialNB()\n",
